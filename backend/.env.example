# Server
NODE_ENV=development
PORT=5000
API_VERSION=v1

# PostgreSQL / Supabase
# Use the Supabase "Direct connection" URI for LOCAL development.
# In production (pooled/Prisma Accelerate), keep the pooler URI in DATABASE_URL.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/assetrix?schema=public
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/assetrix?schema=public

# JWT (generate strong secrets, e.g. `openssl rand -hex 32`)
JWT_SECRET=change-me-to-a-long-random-secret
JWT_REFRESH_SECRET=change-me-to-a-different-long-random-secret
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Supabase (for Storage)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET_AVATARS=avatars
SUPABASE_STORAGE_BUCKET_ASSET_DOCUMENTS=asset-documents
SUPABASE_STORAGE_BUCKET_MAINTENANCE_ATTACHMENTS=maintenance-attachments
SUPABASE_STORAGE_BUCKET_REPORTS=reports

# Frontend origin (CORS + email links)
FRONTEND_URL=http://localhost:5173

# SMTP email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=Assetrix <noreply@assetrix.com>

# Uploads
MAX_FILE_SIZE=10485760

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
